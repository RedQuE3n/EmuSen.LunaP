<Project Sdk="Microsoft.NET.Sdk">

  <!-- LunaP: a small Avalonia toolkit. Theme, controls, window scaffolding and
       a fluent layout surface, so an application stops rebuilding chrome from
       raw primitives. Named for Luna-P, Chibiusa's gadget ball.

       It was written inside the EmuSen emulator project, where three frontends
       consume it, and it moved here once it depended on nothing of EmuSen's at
       all. docs/LunaP.md §19 records what had to go for that to be true and
       where each piece went; §20 records the move itself.

       THE RULE THAT MADE THE MOVE POSSIBLE, and it is worth keeping: this
       project references AVALONIA AND NOTHING ELSE. Not a settings library,
       not a logging library, not an application's own types. Every control
       takes plain data or a delegate, and everything that would otherwise need
       a dependency arrives through a seam the host fills in - Settings/
       ISettingsStore is the only one so far. A toolkit that names its first
       consumer is a toolkit only that consumer can use. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- OFF, SO THAT EVERY FILE SPELLS ITS OWN IMPORTS - see docs/LunaP.md §74.7.
         The SDK would supply System, System.Collections.Generic, System.Linq and a
         few more to every file for free. Every file here already writes them, so
         nothing is gained by the convenience and one real thing is lost: with it
         ON, a missing `using` is invisible, and there is no way to tell a file
         that imports what it needs from one that is quietly living off the
         default set. Two files were, and nobody could have known.
         Off, the compiler enforces the convention instead of the author
         remembering it. It does NOT catch an UNNECESSARY using - nothing here
         does, and §74.6 says why that is recorded rather than guarded. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- UNSAFE IS ON FOR EXACTLY ONE METHOD: RgbaImageView.Blit, which copies a
         frame into the locked framebuffer - see docs/LunaP.md §53.

         It is here because the alternative is a fake. A ReadOnlySpan<byte> or a
         native-pointer overload exists to REMOVE a copy, and safe C# cannot
         write to native memory at all: there is no safe way to make a Span over
         ILockedFramebuffer.Address, and Marshal.Copy takes arrays only. A "span"
         overload implemented safely would have to copy the span into a temporary
         array first, which adds an allocation and a copy to a method whose whole
         purpose is to remove one - an API that reads as an optimisation and is a
         pessimisation.

         The scope is one 12-line method that copies a measured number of bytes
         into a buffer it just locked, and every entry point to it bounds-checks
         first. Nothing else in this toolkit may use it without a § of its own. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The .xml beside the .dll, which is the only thing a consumer's IntelliSense
         reads. Sixty-three public types offered it nothing until §33.

         CS1591 ("missing XML comment") IS SUPPRESSED ON PURPOSE, and that is the
         decision rather than an oversight. Turning it on demands a sentence for
         all 460 public members, including 41 Avalonia StyledProperty fields and
         58 protected overrides of OnApplyTemplate and friends, where the only
         sentence available restates the name. This repository's position is that
         a comment which has drifted is worse than none because it is believed,
         and filler is the same failure arriving pre-drifted.

         So the rule is enforced where it carries information and nowhere else:
         EVERY PUBLIC TYPE HAS A SUMMARY, and DocumentationTests fails the build
         if one does not. Members get a summary when the name does not already
         say it. See docs/LunaP.md §33. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>EmuSen.LunaP</PackageId>
    <!-- 0.8.0. The published version comes from the git tag, so this is only
         the default for a local `dotnet pack` - kept in step so the two never
         tell different stories.

         0.8.0 IS THE FIRST RELEASE SINCE 0.7.0 THAT IS NOT PURELY ADDITIVE, and
         that is what makes it a minor bump rather than a patch. §48 hands
         LunaP's colours to FluentTheme's own resource keys, so every stock
         Avalonia control in a consumer's application - a TextBox, a CheckBox, a
         Slider - changes colour on upgrade. Nothing about behaviour, layout or
         API moves; only paint. But a consumer reading 0.7.2 would not expect
         their text boxes repainted, and that is the whole argument (§51).

         It also carries a window-placement fix that reaches anybody with a
         WindowKey: a window closed while maximized or full screen, with nothing
         stored from a previous run, saved the SCREEN's bounds as its own
         restored size and reopened the size of the display (§75.6). The
         maximized half of that has been there since 0.2.0.

         AND IT CARRIES 0.7.1, which was prepared and never released. Both
         .csproj files said 0.7.1 and CHANGELOG.md has its entry, but no v0.7.1
         tag was ever pushed - and since the published version comes from the
         tag, the settings-root fix of §43 has never reached a consumer (§51.1).
         That is the failure this comment exists to make visible: the number here
         is not evidence that anything shipped.

         0.7.0 before it was the shell: actions, menus, a toolbar, context menus,
         keyboard shortcuts, a splitter, docked side panels and an AppWindow to
         hold them (§26). All of it additive - no control changed shape, no
         palette key moved, no template part was renamed - so following it was a
         version number, costing only a vocabulary check: one new palette token
         and five new CSS element names (§26.13).

         0.6.0 carried no code change at all; it was the relicence from
         GPL-3.0-or-later to MIT (§25), which is the largest thing a version can
         mean to a consumer who could not previously link this into a closed
         application. CHANGELOG.md is the consumer's account of all of them. -->
    <Version>0.8.0</Version>
    <Authors>Tristan Pelland</Authors>
    <Description>A small Avalonia toolkit: theme, controls, an application shell, window scaffolding and a fluent layout surface.</Description>
    <!-- MIT as of 0.6.0; 0.2.0-0.5.0 shipped GPL-3.0-or-later and stay that way
         on nuget.org, which cannot edit a published package's metadata. Every
         dependency below is MIT, so nothing here forces a copyleft term on a
         consumer - see §25. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/RedQuE3n/EmuSen.LunaP</RepositoryUrl>
    <PackageTags>avalonia;ui;toolkit;theme;controls</PackageTags>
  </PropertyGroup>

  <!-- Symbols, SourceLink and the deterministic-under-CI switch are in
       Directory.Build.props at the repository root, which applies to this
       project and to the harness together - see §31. They are not repeated here
       because the two packages must carry identical publication settings, and
       two copies is how they would stop. -->

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Desktop, Fonts.Inter and X11 are here for LunaApp.Configure, which owns
         the UsePlatformDetect/WithInterFont/LogToTrace/UseX11 sequence an
         application's Program.cs would otherwise spell out - and which is the
         one place the Wayland/X11 correction lives. See docs/LunaP.md §3. -->
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.X11" Version="12.1.0" />
  </ItemGroup>

</Project>
