<Project Sdk="Microsoft.NET.Sdk">

  <!-- LunaP: a small Avalonia toolkit. Theme, controls, window scaffolding and
       a fluent layout surface, so an application stops rebuilding chrome from
       raw primitives. Named for Luna-P, Chibiusa's gadget ball.

       It was written inside the EmuSen emulator project, where three frontends
       consume it, and it moved here once it depended on nothing of EmuSen's at
       all. docs/LunaP.md §19 records what had to go for that to be true and
       where each piece went; §20 records the move itself.

       THE RULE THAT MADE THE MOVE POSSIBLE, and it is worth keeping: this
       project references AVALONIA AND NOTHING ELSE. Not a settings library,
       not a logging library, not an application's own types. Every control
       takes plain data or a delegate, and everything that would otherwise need
       a dependency arrives through a seam the host fills in - Settings/
       ISettingsStore is the only one so far. A toolkit that names its first
       consumer is a toolkit only that consumer can use. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>EmuSen.LunaP</PackageId>
    <!-- 0.7.0. The published version comes from the git tag, so this is only
         the default for a local `dotnet pack` - kept in step so the two never
         tell different stories.

         0.7.0 is the shell: actions, menus, a toolbar, context menus, keyboard
         shortcuts, a splitter, docked side panels and an AppWindow to hold them
         (§26). All of it is additive - no control changed shape, no palette key
         moved, no template part was renamed - so following it is a version
         number. The one thing it costs is a vocabulary check: one new palette
         token and five new CSS element names (§26.13).

         0.6.0 before it carried no code change at all; it was the relicence
         from GPL-3.0-or-later to MIT (§25), which is the largest thing a
         version can mean to a consumer who could not previously link this into
         a closed application. CHANGELOG.md is the consumer's account of both. -->
    <Version>0.7.0</Version>
    <Authors>Tristan Pelland</Authors>
    <Description>A small Avalonia toolkit: theme, controls, an application shell, window scaffolding and a fluent layout surface.</Description>
    <!-- MIT as of 0.6.0; 0.2.0-0.5.0 shipped GPL-3.0-or-later and stay that way
         on nuget.org, which cannot edit a published package's metadata. Every
         dependency below is MIT, so nothing here forces a copyleft term on a
         consumer - see §25. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/RedQuE3n/EmuSen.LunaP</RepositoryUrl>
    <PackageTags>avalonia;ui;toolkit;theme;controls</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Desktop, Fonts.Inter and X11 are here for LunaApp.Configure, which owns
         the UsePlatformDetect/WithInterFont/LogToTrace/UseX11 sequence an
         application's Program.cs would otherwise spell out - and which is the
         one place the Wayland/X11 correction lives. See docs/LunaP.md §3. -->
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.X11" Version="12.1.0" />
  </ItemGroup>

</Project>
