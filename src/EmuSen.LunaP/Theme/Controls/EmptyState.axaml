<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Controls">

    <!-- Body-sized and muted, NOT a HintText: an empty state is the window's whole
         content in that state, not an aside under something else. CoretopWindow
         wrote that distinction in a comment before this control existed - see
         docs/LunaP.md §22.9. -->
    <Style Selector="luna|EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="4">
                    <TextBlock Name="PART_Message"
                               Text="{TemplateBinding Message}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Name="PART_Detail"
                               Text="{TemplateBinding Detail}"
                               IsVisible="{TemplateBinding HasDetail}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The look, set from styles rather than as attributes on the elements
         above, so that `empty-state .message` and `empty-state .detail` can
         actually reach it. A value written into a ControlTemplate binds at
         priority Template, which OUTRANKS Style, so a host rule matched the part
         and lost - measured, §39.2. The rendered default is unchanged. -->
    <Style Selector="luna|EmptyState /template/ TextBlock#PART_Message">
        <Setter Property="Foreground" Value="{DynamicResource LunaMuted}" />
    </Style>

    <Style Selector="luna|EmptyState /template/ TextBlock#PART_Detail">
        <Setter Property="Foreground" Value="{DynamicResource LunaMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource LunaHintFontSize}" />
    </Style>

</Styles>
