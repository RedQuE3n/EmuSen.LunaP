<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Controls">

    <Style Selector="luna|SidePanel">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Background="{DynamicResource LunaSurface}">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,6,4,6">
                        <TextBlock Name="PART_Title"
                                   Grid.Column="0"
                                   Text="{TemplateBinding Title}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <!-- The visible glyph is a cross, which a screen reader
                             cannot say and voice control cannot be told to
                             click, so the NAME is the word and the glyph is
                             decoration. Several panels mean several buttons
                             called Close, told apart by help text - the same
                             arrangement four Browse... buttons needed (§24.2). -->
                        <Button Name="PART_Close"
                                Grid.Column="1"
                                Content="&#x2715;"
                                IsVisible="{TemplateBinding CanClose}"
                                AutomationProperties.Name="Close"
                                AutomationProperties.HelpText="{TemplateBinding Title}"
                                Padding="6,2"
                                BorderThickness="0" />
                    </Grid>

                    <Border DockPanel.Dock="Top"
                            Height="1"
                            Background="{DynamicResource LunaBorder}"
                            Margin="0,0,0,6" />

                    <ContentPresenter Name="PART_Content" Content="{TemplateBinding Content}" Margin="8,0,8,8" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Set from styles so `side-panel .title` and `side-panel .close` can reach
         them: an attribute inside a ControlTemplate binds at priority Template,
         which outranks Style, and a host rule that matched the part lost to it -
         measured, §39.2. Same defaults, overridable now. -->
    <Style Selector="luna|SidePanel /template/ TextBlock#PART_Title">
        <Setter Property="Foreground" Value="{DynamicResource LunaText}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource LunaHintFontSize}" />
    </Style>

    <!-- Transparent so the panel's surface shows through, which is the default a
         host most plausibly wants to change - a close button that needs to be
         findable on a light theme. -->
    <Style Selector="luna|SidePanel /template/ Button#PART_Close">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>
