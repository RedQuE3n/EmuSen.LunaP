<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Controls">

    <Style Selector="luna|RgbaImageView">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Stretch is NOT TemplateBound, and that is deliberate since
                     §53.1: integer scaling sets an exact size on this Image and
                     a Stretch that fills it, so the control drives both from
                     ApplyScale rather than the two competing for one property.

                     BitmapInterpolationMode stays None, which is the other half
                     of a pixel-accurate view - it is what makes an integer
                     factor produce crisp square pixels rather than a blur. -->
                <Image Name="PART_Image"
                       Source="{TemplateBinding Source}"
                       RenderOptions.BitmapInterpolationMode="None" />
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
