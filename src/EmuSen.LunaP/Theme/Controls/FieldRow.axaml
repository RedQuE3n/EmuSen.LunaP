<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Controls">

    <Style Selector="luna|FieldRow">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="4">
                    <!-- Named so FieldRow can point the content's LabeledBy at it.
                         Renaming this part breaks the pairing silently, which is
                         why AccessibilityTests asserts the content comes back
                         named rather than asserting the part exists. -->
                    <TextBlock Name="PART_Label" Text="{TemplateBinding Label}" FontWeight="Bold" />
                    <luna:HintText Text="{TemplateBinding Hint}" IsVisible="{TemplateBinding HasHint}" />
                    <ContentPresenter Content="{TemplateBinding Content}" />

                    <!-- BELOW the content and not above it, which is the one
                         layout decision here worth stating. An error added above
                         would push the field down as it appears, so the control
                         a user is typing in moves out from under the pointer at
                         the moment they are told they got it wrong. Underneath,
                         the field stays where it is and the message arrives in
                         the space below. §49. -->
                    <luna:ErrorText Name="PART_Error"
                                    Text="{TemplateBinding Error}"
                                    IsVisible="{TemplateBinding HasError}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
