<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The rule behind Windowing/EmbeddedPopups.cs: a popup under an element carrying the class is drawn in the
         window's overlay layer. A class rather than a style added to the element, because Avalonia re-evaluates a
         selector when a class changes but did not re-evaluate a template's Popup when an added style was removed.
         docs/LunaP.md §92.5. -->
    <Style Selector=".luna-embedded-popups Popup">
        <Setter Property="ShouldUseOverlayLayer" Value="True" />
    </Style>

</Styles>
