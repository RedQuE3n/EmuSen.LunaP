<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:EmuSen.LunaP.Theme">

    <!-- The big screen's palette: the interface's colour tokens (dark here; MenuLook.CreatePalette swaps in the light
         column), their brushes, the big screen's metrics, and FluentTheme's keys painted from the tokens, for the look
         (MenuLook.axaml) and for a menu that draws itself (MenuPanel). No colour is written here: the values are
         Tokens/Dark.axaml's and Tokens/Light.axaml's, the desktop's too - docs/LunaP.md §196, §200.3 and §206.1. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EmuSen.LunaP/Theme/Tokens/Dark.axaml" />
        <ResourceInclude Source="avares://EmuSen.LunaP/Theme/Tokens/Brushes.axaml" />
        <theme:LunaMetrics Form="BigScreen" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Fluent's keys, which its templates look up where they draw, so the parts no style reaches follow too. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource LunaInputSurfaceColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource LunaInputSurfaceColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource LunaSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource LunaBorderColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource LunaAccentColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{DynamicResource LunaAccentColor}" />

    <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource LunaInputSurfaceColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource LunaInputSurfaceColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{DynamicResource LunaInputSurfaceColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{DynamicResource LunaSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource LunaBorderColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{DynamicResource LunaBorderColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource LunaSurfaceColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource LunaRuleColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{DynamicResource LunaTextColor}" />
    <!-- Focused, the stock template draws the words and the arrow in white at 80%, a colour no key here declared (§200.3). -->
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource LunaSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{DynamicResource LunaSurfaceRaisedColor}" />

    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource LunaSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource LunaSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource LunaBorderColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource LunaBorderColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource LunaRuleColor}" />
    <SolidColorBrush x:Key="RepeatButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="RepeatButtonForeground" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{DynamicResource LunaSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{DynamicResource LunaTextStrongColor}" />

    <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource LunaAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource LunaAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource LunaOnAccentColor}" />

    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource LunaAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource LunaAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource LunaOnAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{DynamicResource LunaTextColor}" />

    <SolidColorBrush x:Key="SliderTrackFill" Color="{DynamicResource LunaRuleColor}" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{DynamicResource LunaRuleColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource LunaAccentColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource LunaAccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource LunaTextStrongColor}" />

    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="{DynamicResource LunaBorderColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{DynamicResource LunaSurfaceRaisedColor}" />

    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="{DynamicResource LunaMutedColor}" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="{DynamicResource LunaTextStrongColor}" />

    <SolidColorBrush x:Key="ToolTipBackground" Color="{DynamicResource LunaSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="{DynamicResource LunaTextColor}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource LunaRuleColor}" />
    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{DynamicResource LunaTextStrongColor}" />
    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{DynamicResource LunaSurfaceRaisedColor}" />
</ResourceDictionary>
