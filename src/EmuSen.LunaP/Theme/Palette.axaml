<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:EmuSen.LunaP.Theme">

    <!-- The desktop's palette: the interface's colour tokens keyed by theme variant, their brushes and the desktop's
         metrics. Keyed by variant because FluentTheme follows the variant, and a flat dark set under a light Fluent drew
         dark on dark (§23.1). The values were the literals already in use until §206, which adopted the unified
         interface's tokens for both the desktop and the big screen; §206.1 has the table and what moved. -->

    <ResourceDictionary.ThemeDictionaries>
        <!-- Each column is one file, read here and by the big screen's palette, so a colour is written once (§206.1). -->
        <ResourceInclude x:Key="Dark" Source="avares://EmuSen.LunaP/Theme/Tokens/Dark.axaml" />
        <ResourceInclude x:Key="Light" Source="avares://EmuSen.LunaP/Theme/Tokens/Light.axaml" />
    </ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EmuSen.LunaP/Theme/Tokens/Brushes.axaml" />
        <theme:LunaMetrics Form="Desktop" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Type and metrics are LunaMetrics' (Tokens/LunaMetrics.cs), the desktop's here; the mono stack is the desktop's alone. -->
    <FontFamily x:Key="LunaMonoFont">Consolas,Menlo,monospace</FontFamily>

</ResourceDictionary>
