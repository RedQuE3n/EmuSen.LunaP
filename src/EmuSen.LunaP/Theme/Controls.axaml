<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Controls">

    <!-- Every look here is the one the frontends already had; LunaPControlTests
         asserts these styles actually apply, because a selector that silently
         stops matching renders as an unstyled control rather than an error.
         See docs/LunaP.md §5.

         THE AutomationProperties.* ATTRIBUTES BELOW ARE LOAD-BEARING, not
         decoration. A template part that a keyboard can reach - a TextBox, a
         Button, a Dropdown - is announced by its accessible name and by nothing
         else, and every one of these was announced as "edit" or "Browse..." with
         no way to tell one from another. They are set here rather than in code
         because a TemplateBinding is the whole of what each one needs, and
         because the name then lives beside the part it names. §24.2. -->


    <Style Selector="luna|SectionHeader">
        <Setter Property="Foreground" Value="{DynamicResource LunaSectionHeader}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="luna|HintText">
        <Setter Property="Foreground" Value="{DynamicResource LunaMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource LunaHintFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Body-sized and muted, NOT a HintText: an empty state is the window's whole
         content in that state, not an aside under something else. CoretopWindow
         wrote that distinction in a comment before this control existed - see
         docs/LunaP.md §22.9. -->
    <Style Selector="luna|EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="4">
                    <TextBlock Name="PART_Message"
                               Text="{TemplateBinding Message}"
                               Foreground="{DynamicResource LunaMuted}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Name="PART_Detail"
                               Text="{TemplateBinding Detail}"
                               IsVisible="{TemplateBinding HasDetail}"
                               Foreground="{DynamicResource LunaMuted}"
                               FontSize="{DynamicResource LunaHintFontSize}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|MonoText">
        <Setter Property="Foreground" Value="{DynamicResource LunaText}" />
        <Setter Property="FontFamily" Value="{DynamicResource LunaMonoFont}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 140/*/55 is what all three hand-written copies used. -->
    <Style Selector="luna|MeterRow">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="140,*,55">
                    <TextBlock Grid.Column="0"
                               Text="{TemplateBinding Label}"
                               Foreground="{DynamicResource LunaMeterText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <!-- Raw keeps this out of the control view. The MeterRow's own
                         peer already reports ProgressBar with the label as its
                         name and the reading as its status, so leaving this in
                         would put a SECOND, nameless progress bar next to it
                         saying the same number with nothing to attach it to. -->
                    <ProgressBar Grid.Column="1"
                                 Name="PART_Bar"
                                 Minimum="0" Maximum="100"
                                 Height="14"
                                 AutomationProperties.AccessibilityView="Raw"
                                 Value="{TemplateBinding Percent}" />
                    <TextBlock Grid.Column="2"
                               Text="{TemplateBinding ValueText}"
                               Foreground="{DynamicResource LunaMeterText}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The ramp lives in styles, not in a computed brush, so a loaded theme reaches it - see docs/LunaP.md §12.1. -->
    <Style Selector="luna|MeterRow:nominal /template/ ProgressBar#PART_Bar">
        <Setter Property="Foreground" Value="{DynamicResource LunaNominal}" />
    </Style>
    <Style Selector="luna|MeterRow:busy /template/ ProgressBar#PART_Bar">
        <Setter Property="Foreground" Value="{DynamicResource LunaBusy}" />
    </Style>
    <Style Selector="luna|MeterRow:hot /template/ ProgressBar#PART_Bar">
        <Setter Property="Foreground" Value="{DynamicResource LunaHot}" />
    </Style>

    <Style Selector="luna|MeterList">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Name="PART_Rows" Spacing="3" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|RgbaImageView">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <Image Name="PART_Image"
                       Source="{TemplateBinding Source}"
                       Stretch="{TemplateBinding Stretch}"
                       RenderOptions.BitmapInterpolationMode="None" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|FieldRow">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="4">
                    <!-- Named so FieldRow can point the content's LabeledBy at it.
                         Renaming this part breaks the pairing silently, which is
                         why AccessibilityTests asserts the content comes back
                         named rather than asserting the part exists. -->
                    <TextBlock Name="PART_Label" Text="{TemplateBinding Label}" FontWeight="Bold" />
                    <luna:HintText Text="{TemplateBinding Hint}" IsVisible="{TemplateBinding HasHint}" />
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|PathPickerRow">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Read-only and still a tab stop, on purpose: the path is
                         often long and truncated on screen, and focusing it is
                         how a keyboard reads or copies the whole thing. That
                         only works if it says which path it holds. -->
                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             AutomationProperties.Name="{TemplateBinding BrowseTitle}"
                             Text="{TemplateBinding Path}"
                             PlaceholderText="{TemplateBinding Placeholder}" />
                    <!-- HelpText, NOT Name. The visible word is "Browse..." and
                         an accessible name that does not contain the visible
                         label breaks voice control - a user saying "click
                         browse" needs the name to be the thing they can see.
                         So the name stays, and what makes THIS browse button
                         different from the four others on the page goes in help
                         text, which is announced after it. -->
                    <Button Grid.Column="1"
                            Name="PART_Browse"
                            Content="Browse..."
                            AutomationProperties.HelpText="{TemplateBinding BrowseTitle}"
                            Margin="8,0,0,0" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Templated explicitly rather than inheriting ItemsControl's: a derived
         control's style key is its own type, so FluentTheme's ItemsControl
         theme does not reach it and it would render as nothing. See
         docs/LunaP.md §5.5. -->
    <Style Selector="luna|ButtonBar">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|StatusBar">
        <!-- Polite, so a changed status is announced when the reader next
             pauses rather than interrupting them. Assertive would cut across
             whatever they were listening to, and a status line carries
             "Applied 12 cheats" far more often than it carries anything that
             cannot wait a moment. A caller whose status updates continuously
             should set this to Off - it is an attached property precisely so
             that stays their decision. §24.2. -->
        <Setter Property="(AutomationProperties.LiveSetting)" Value="Polite" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{TemplateBinding Status}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The facet label and dropdown collapse together when there is nothing to pick. -->
    <Style Selector="luna|FilterBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Column="0"
                               Text="{TemplateBinding FacetLabel}"
                               IsVisible="{TemplateBinding ShowFacet}"
                               Foreground="{DynamicResource LunaMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <!-- The facet's visible label is the TextBlock above, which
                         is a sibling and not something a reader would connect
                         to the dropdown. FacetLabel already holds the words. -->
                    <luna:Dropdown Grid.Column="1"
                                   Name="PART_Facet"
                                   MinWidth="180"
                                   Margin="0,0,8,0"
                                   AutomationProperties.Name="{TemplateBinding FacetLabel}"
                                   IsVisible="{TemplateBinding ShowFacet}" />
                    <!-- Placeholder as the NAME as well as the placeholder. The
                         two are not the same thing: a placeholder disappears the
                         moment the user types, which is exactly when they may
                         want reminding what they are searching. -->
                    <TextBox Grid.Column="2"
                             Name="PART_Search"
                             AutomationProperties.Name="{TemplateBinding Placeholder}"
                             Text="{TemplateBinding SearchText}"
                             PlaceholderText="{TemplateBinding Placeholder}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ==================================================================
         The shell: menu bar, toolbar, card, splitter, side panel. §26.
         ================================================================== -->

    <!-- Transparent rather than Fluent's own chrome colour, so the strip is the
         window's LunaSurface and a theme that repaints the window repaints the
         menu bar with it. Fluent's Menu paints #2C2C2C on dark, which against
         LunaSurface's #1E1E1E reads as a lighter bar somebody forgot to style. -->
    <Style Selector="luna|MenuBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="2,0" />
    </Style>

    <!-- Templated explicitly for the same reason ButtonBar is: a derived
         control's style key is its own type, so FluentTheme's ItemsControl
         theme never reaches it and it renders as nothing. §5.5.

         Left-aligned, which is the visible difference from ButtonBar - and the
         difference in kind is that these items are built from actions, so they
         follow an enabled state rather than holding one. -->
    <Style Selector="luna|ToolBar">
        <Setter Property="BorderBrush" Value="{DynamicResource LunaBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <!-- On its side. Avalonia's Separator is the horizontal rule a MENU wants,
         and dropped unstyled into a horizontal strip it draws a full-width bar
         that pushes every button after it off the end. -->
    <Style Selector="luna|ToolBar Separator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="{DynamicResource LunaBorder}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The surface three consumers painted by hand with FluentTheme's
         SystemChromeLowColor - a resource LunaP's own theme cannot reach, which
         is why a theme change left all three behind. §21.2, §26.9. -->
    <Style Selector="luna|Card">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource LunaInputSurface}"
                        BorderBrush="{DynamicResource LunaBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <!-- Collapses rather than reserving a blank line, the
                             same arrangement FieldRow's hint uses. -->
                        <!-- TextElement, not TextBlock: Avalonia hangs the
                             inheritable text properties off TextElement, and
                             the WPF spelling compiles to nothing a
                             ContentPresenter can set. A header given as a
                             string is rendered by a TextBlock the presenter
                             makes for itself, so this is the only way to reach
                             it without demanding the caller pass a control. -->
                        <ContentPresenter Name="PART_Header"
                                          Content="{TemplateBinding Header}"
                                          IsVisible="{TemplateBinding HasHeader}"
                                          TextElement.FontWeight="Bold"
                                          TextElement.Foreground="{DynamicResource LunaSectionHeader}" />
                        <ContentPresenter Name="PART_Content" Content="{TemplateBinding Content}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The grid's definitions are built in code, because how many tracks there
         are and which way round they go depends on Orientation and on whether
         either pane is null. What stays here is the look.

         A WIDE GRAB AREA WITH A THIN LINE IN IT, which is two requirements that
         disagree: the divider should read as a hairline and be catchable with a
         mouse. Fluent's GridSplitter paints its whole width, so a 4pt grab area
         would be a 4pt bar. So the splitter is transparent and the rule is a
         separate one-pixel Border in the same grid cell, sized and turned by
         the same code that already decides which way the grid runs.

         PART_Rule is not hit-testable, and that is load-bearing rather than
         tidy: it sits ON TOP of the splitter in the same cell, so if it took
         input it would swallow the middle of the drag target and the divider
         would only be draggable on the pixels either side of the line. -->
    <Style Selector="luna|SplitPane">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="PART_Grid">
                    <ContentPresenter Name="PART_First" />
                    <!-- NAMED, because Avalonia's GridSplitter is a tab stop that
                         responds to the arrow keys - measured: one Left press
                         moves a 200pt pane to 190. It is a control a keyboard
                         reaches and uses, so an unnamed one is a place the focus
                         can land with nothing to say what it is. §26.11. -->
                    <GridSplitter Name="PART_Splitter"
                                  Background="Transparent"
                                  AutomationProperties.Name="{TemplateBinding DividerLabel}" />
                    <Border Name="PART_Rule"
                            Background="{DynamicResource LunaBorder}"
                            IsHitTestVisible="False" />
                    <ContentPresenter Name="PART_Second" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- A header row above a list, sharing its column widths with every row in
         it - see docs/LunaP.md §27.

         Grid.IsSharedSizeScope is what makes an Auto column line up: the header
         grid and each row grid are separate grids, so without a shared scope an
         Auto column would size itself independently in every one of them and
         nothing would align. The scope goes on the root so both parts are
         inside it.

         The header's padding matches the item container's below, because those
         two numbers are what actually decide whether a column heading sits over
         its own cells.

         `:is(...)` AND NOT A BARE TYPE SELECTOR, which is the whole reason the
         first draft of this style did nothing at all. An Avalonia type selector
         is an EXACT match: `luna|LunaTable` selects instances whose type is
         precisely LunaTable, and every instance there will ever be is a
         LunaTable<T> deriving from it. The symptom is the one §5.5 keeps
         recording - a control with no template, no error, and nothing on
         screen. Every other style in this file names a type that is
         instantiated directly, which is why the trap has not appeared here
         before. -->
    <Style Selector=":is(luna|LunaTable)">
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource LunaBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="12,4,12,6">
                        <Grid Name="PART_Header" />
                    </Border>
                    <ListBox Name="PART_Rows"
                             Background="Transparent"
                             BorderThickness="0" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The other half of the alignment. Fluent's ListBoxItem padding is not the
         header's, so left alone the columns start at two different x positions;
         this pins both to 12. The vertical figure is smaller than Fluent's
         default because a table is read as rows of data rather than as a menu
         of choices, and Fluent's spacing puts four fields on a screen. -->
    <Style Selector=":is(luna|LunaTable) ListBoxItem">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="luna|SidePanel">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Background="{DynamicResource LunaSurface}">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,6,4,6">
                        <TextBlock Name="PART_Title"
                                   Grid.Column="0"
                                   Text="{TemplateBinding Title}"
                                   Foreground="{DynamicResource LunaText}"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource LunaHintFontSize}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <!-- The visible glyph is a cross, which a screen reader
                             cannot say and voice control cannot be told to
                             click, so the NAME is the word and the glyph is
                             decoration. Several panels mean several buttons
                             called Close, told apart by help text - the same
                             arrangement four Browse... buttons needed (§24.2). -->
                        <Button Name="PART_Close"
                                Grid.Column="1"
                                Content="&#x2715;"
                                IsVisible="{TemplateBinding CanClose}"
                                AutomationProperties.Name="Close"
                                AutomationProperties.HelpText="{TemplateBinding Title}"
                                Padding="6,2"
                                Background="Transparent"
                                BorderThickness="0" />
                    </Grid>

                    <Border DockPanel.Dock="Top"
                            Height="1"
                            Background="{DynamicResource LunaBorder}"
                            Margin="0,0,0,6" />

                    <ContentPresenter Name="PART_Content" Content="{TemplateBinding Content}" Margin="8,0,8,8" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|ConsolePane">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0"
                                   Name="PART_Prompt"
                                   Text="{TemplateBinding Prompt}"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource LunaMonoFont}"
                                   Foreground="{DynamicResource LunaText}"
                                   Margin="0,0,4,0" />
                        <!-- Not named from Prompt. A prompt is "> " or "diana$ ",
                             which is a sigil and reads as punctuation. -->
                        <TextBox Grid.Column="1"
                                 Name="PART_Input"
                                 AutomationProperties.Name="Console input"
                                 FontFamily="{DynamicResource LunaMonoFont}"
                                 Background="{DynamicResource LunaInputSurface}"
                                 Foreground="{DynamicResource LunaText}"
                                 CaretBrush="{DynamicResource LunaText}"
                                 BorderThickness="1" />
                    </Grid>

                    <ScrollViewer Name="PART_Scroll">
                        <!-- A tab stop by virtue of being selectable, which is
                             worth keeping: it is how a keyboard selects and
                             copies output.

                             DELIBERATELY NOT GIVEN AutomationProperties.Name,
                             because on a text block it would do nothing.
                             Avalonia 12.1.0's TextBlockAutomationPeer overrides
                             GetNameCore to return Text and never consults the
                             attached property, so the name here is the output
                             itself - which is what a reader wants from a console
                             anyway - and an empty console has no name at all.
                             Measured, with the reproduction, in §24.5. Setting
                             the attribute would read as a fix and be one line of
                             ignored XAML. -->
                        <SelectableTextBlock Name="PART_Output"
                                             FontFamily="{DynamicResource LunaMonoFont}"
                                             Foreground="{DynamicResource LunaText}"
                                             TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
