<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:luna="clr-namespace:EmuSen.LunaP.Controls">

    <!-- Every look here is the one the frontends already had; LunaPControlTests
         asserts these styles actually apply, because a selector that silently
         stops matching renders as an unstyled control rather than an error.
         See docs/LunaP.md §5.

         THE AutomationProperties.* ATTRIBUTES BELOW ARE LOAD-BEARING, not
         decoration. A template part that a keyboard can reach - a TextBox, a
         Button, a Dropdown - is announced by its accessible name and by nothing
         else, and every one of these was announced as "edit" or "Browse..." with
         no way to tell one from another. They are set here rather than in code
         because a TemplateBinding is the whole of what each one needs, and
         because the name then lives beside the part it names. §24.2. -->


    <Style Selector="luna|SectionHeader">
        <Setter Property="Foreground" Value="{DynamicResource LunaSectionHeader}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="luna|HintText">
        <Setter Property="Foreground" Value="{DynamicResource LunaMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource LunaHintFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Body-sized and muted, NOT a HintText: an empty state is the window's whole
         content in that state, not an aside under something else. CoretopWindow
         wrote that distinction in a comment before this control existed - see
         docs/LunaP.md §22.9. -->
    <Style Selector="luna|EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="4">
                    <TextBlock Name="PART_Message"
                               Text="{TemplateBinding Message}"
                               Foreground="{DynamicResource LunaMuted}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Name="PART_Detail"
                               Text="{TemplateBinding Detail}"
                               IsVisible="{TemplateBinding HasDetail}"
                               Foreground="{DynamicResource LunaMuted}"
                               FontSize="{DynamicResource LunaHintFontSize}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|MonoText">
        <Setter Property="Foreground" Value="{DynamicResource LunaText}" />
        <Setter Property="FontFamily" Value="{DynamicResource LunaMonoFont}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 140/*/55 is what all three hand-written copies used. -->
    <Style Selector="luna|MeterRow">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="140,*,55">
                    <TextBlock Grid.Column="0"
                               Text="{TemplateBinding Label}"
                               Foreground="{DynamicResource LunaMeterText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <!-- Raw keeps this out of the control view. The MeterRow's own
                         peer already reports ProgressBar with the label as its
                         name and the reading as its status, so leaving this in
                         would put a SECOND, nameless progress bar next to it
                         saying the same number with nothing to attach it to. -->
                    <ProgressBar Grid.Column="1"
                                 Name="PART_Bar"
                                 Minimum="0" Maximum="100"
                                 Height="14"
                                 AutomationProperties.AccessibilityView="Raw"
                                 Value="{TemplateBinding Percent}" />
                    <TextBlock Grid.Column="2"
                               Text="{TemplateBinding ValueText}"
                               Foreground="{DynamicResource LunaMeterText}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The ramp lives in styles, not in a computed brush, so a loaded theme reaches it - see docs/LunaP.md §12.1. -->
    <Style Selector="luna|MeterRow:nominal /template/ ProgressBar#PART_Bar">
        <Setter Property="Foreground" Value="{DynamicResource LunaNominal}" />
    </Style>
    <Style Selector="luna|MeterRow:busy /template/ ProgressBar#PART_Bar">
        <Setter Property="Foreground" Value="{DynamicResource LunaBusy}" />
    </Style>
    <Style Selector="luna|MeterRow:hot /template/ ProgressBar#PART_Bar">
        <Setter Property="Foreground" Value="{DynamicResource LunaHot}" />
    </Style>

    <Style Selector="luna|MeterList">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Name="PART_Rows" Spacing="3" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|RgbaImageView">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <Image Name="PART_Image"
                       Source="{TemplateBinding Source}"
                       Stretch="{TemplateBinding Stretch}"
                       RenderOptions.BitmapInterpolationMode="None" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|FieldRow">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="4">
                    <!-- Named so FieldRow can point the content's LabeledBy at it.
                         Renaming this part breaks the pairing silently, which is
                         why AccessibilityTests asserts the content comes back
                         named rather than asserting the part exists. -->
                    <TextBlock Name="PART_Label" Text="{TemplateBinding Label}" FontWeight="Bold" />
                    <luna:HintText Text="{TemplateBinding Hint}" IsVisible="{TemplateBinding HasHint}" />
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|PathPickerRow">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Read-only and still a tab stop, on purpose: the path is
                         often long and truncated on screen, and focusing it is
                         how a keyboard reads or copies the whole thing. That
                         only works if it says which path it holds. -->
                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             AutomationProperties.Name="{TemplateBinding BrowseTitle}"
                             Text="{TemplateBinding Path}"
                             PlaceholderText="{TemplateBinding Placeholder}" />
                    <!-- HelpText, NOT Name. The visible word is "Browse..." and
                         an accessible name that does not contain the visible
                         label breaks voice control - a user saying "click
                         browse" needs the name to be the thing they can see.
                         So the name stays, and what makes THIS browse button
                         different from the four others on the page goes in help
                         text, which is announced after it. -->
                    <Button Grid.Column="1"
                            Name="PART_Browse"
                            Content="Browse..."
                            AutomationProperties.HelpText="{TemplateBinding BrowseTitle}"
                            Margin="8,0,0,0" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Templated explicitly rather than inheriting ItemsControl's: a derived
         control's style key is its own type, so FluentTheme's ItemsControl
         theme does not reach it and it would render as nothing. See
         docs/LunaP.md §5.5. -->
    <Style Selector="luna|ButtonBar">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|StatusBar">
        <!-- Polite, so a changed status is announced when the reader next
             pauses rather than interrupting them. Assertive would cut across
             whatever they were listening to, and a status line carries
             "Applied 12 cheats" far more often than it carries anything that
             cannot wait a moment. A caller whose status updates continuously
             should set this to Off - it is an attached property precisely so
             that stays their decision. §24.2. -->
        <Setter Property="(AutomationProperties.LiveSetting)" Value="Polite" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{TemplateBinding Status}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The facet label and dropdown collapse together when there is nothing to pick. -->
    <Style Selector="luna|FilterBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Column="0"
                               Text="{TemplateBinding FacetLabel}"
                               IsVisible="{TemplateBinding ShowFacet}"
                               Foreground="{DynamicResource LunaMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <!-- The facet's visible label is the TextBlock above, which
                         is a sibling and not something a reader would connect
                         to the dropdown. FacetLabel already holds the words. -->
                    <luna:Dropdown Grid.Column="1"
                                   Name="PART_Facet"
                                   MinWidth="180"
                                   Margin="0,0,8,0"
                                   AutomationProperties.Name="{TemplateBinding FacetLabel}"
                                   IsVisible="{TemplateBinding ShowFacet}" />
                    <!-- Placeholder as the NAME as well as the placeholder. The
                         two are not the same thing: a placeholder disappears the
                         moment the user types, which is exactly when they may
                         want reminding what they are searching. -->
                    <TextBox Grid.Column="2"
                             Name="PART_Search"
                             AutomationProperties.Name="{TemplateBinding Placeholder}"
                             Text="{TemplateBinding SearchText}"
                             PlaceholderText="{TemplateBinding Placeholder}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="luna|ConsolePane">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0"
                                   Name="PART_Prompt"
                                   Text="{TemplateBinding Prompt}"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource LunaMonoFont}"
                                   Foreground="{DynamicResource LunaText}"
                                   Margin="0,0,4,0" />
                        <!-- Not named from Prompt. A prompt is "> " or "diana$ ",
                             which is a sigil and reads as punctuation. -->
                        <TextBox Grid.Column="1"
                                 Name="PART_Input"
                                 AutomationProperties.Name="Console input"
                                 FontFamily="{DynamicResource LunaMonoFont}"
                                 Background="{DynamicResource LunaInputSurface}"
                                 Foreground="{DynamicResource LunaText}"
                                 CaretBrush="{DynamicResource LunaText}"
                                 BorderThickness="1" />
                    </Grid>

                    <ScrollViewer Name="PART_Scroll">
                        <!-- A tab stop by virtue of being selectable, which is
                             worth keeping: it is how a keyboard selects and
                             copies output.

                             DELIBERATELY NOT GIVEN AutomationProperties.Name,
                             because on a text block it would do nothing.
                             Avalonia 12.1.0's TextBlockAutomationPeer overrides
                             GetNameCore to return Text and never consults the
                             attached property, so the name here is the output
                             itself - which is what a reader wants from a console
                             anyway - and an empty console has no name at all.
                             Measured, with the reproduction, in §24.5. Setting
                             the attribute would read as a fix and be one line of
                             ignored XAML. -->
                        <SelectableTextBlock Name="PART_Output"
                                             FontFamily="{DynamicResource LunaMonoFont}"
                                             Foreground="{DynamicResource LunaText}"
                                             TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
