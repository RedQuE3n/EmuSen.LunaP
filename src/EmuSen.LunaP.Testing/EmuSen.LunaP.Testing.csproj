<Project Sdk="Microsoft.NET.Sdk">

  <!-- The test harness, as a package, because it was being copied by hand.

       EmuSen.WiseMan/LunaP/VisualQuery.cs is byte-identical to the copy that
       lived here apart from its namespace line; WiseMan's UiTest re-declares
       RenderedFrame; and EmuSen.Pegasus, unable to reference either, wrote a
       third harness in F#. The cause was one line - the test project that held
       these is IsPackable=false, so there was no other way to obtain
       AssertLaidOut. docs/LunaP.md §22.8.

       WHY THIS IS A SECOND PACKAGE AND NOT PART OF THE TOOLKIT. EmuSen.LunaP
       references Avalonia and nothing else, and that rule is the reason it was
       able to leave EmuSen at all. A harness needs xunit and Avalonia.Headless,
       which it may not name. So the rule does not bend: it applies to the
       toolkit assembly, and this is a sibling a consumer references from its
       TEST project only. Nothing an application ships gains a dependency.

       LayeringTests in the suite asserts that separation from the other side -
       EmuSen.LunaP must not reference this. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- The harness is a published package too, so its IntelliSense is a
         consumer's IntelliSense. Same bargain as the toolkit: every public type
         carries a summary and CS1591 stays off, because a member whose name is
         the whole story does not need a sentence saying the name again. §33. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>EmuSen.LunaP.Testing</PackageId>
    <!-- Tracks the toolkit's version rather than keeping its own, because the
         harness asserts about the toolkit's controls and a consumer pairing
         0.7.0 of one with 0.2.0 of the other has a question nobody wants to
         answer. The published number comes from the git tag either way - see
         .github/workflows/publish.yml. -->
    <Version>0.7.0</Version>
    <Authors>Tristan Pelland</Authors>
    <Description>Headless test harness for EmuSen.LunaP: render capture, layout assertions and visual-tree queries.</Description>
    <!-- MIT as of 0.6.0, in step with the toolkit (§25). The harness links
         xunit.assert, which is Apache-2.0 - permissive, and compatible, but it
         is the one dependency in either package that is not MIT, so a consumer
         redistributing this one carries Apache-2.0's notice terms as well. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RedQuE3n/EmuSen.LunaP</RepositoryUrl>
    <PackageTags>avalonia;ui;testing;headless;xunit</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Symbols, SourceLink and the deterministic-under-CI switch are in
       Directory.Build.props at the repository root, shared with the toolkit so
       the two packages cannot drift apart on how they are published - see §31. -->

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit.assert, not xunit. The harness calls Assert and nothing else, and
         pulling the full metapackage would put xunit.core's Fact/Theory into
         every consumer that references this - including one that runs its own
         tests on a different runner. -->
    <PackageReference Include="xunit.assert" Version="2.9.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <!-- The real render pass AssertLaidOut depends on: without Skia a capture
         goes through the headless drawing stub and every colour count is a lie. -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmuSen.LunaP\EmuSen.LunaP.csproj" />
  </ItemGroup>

</Project>
