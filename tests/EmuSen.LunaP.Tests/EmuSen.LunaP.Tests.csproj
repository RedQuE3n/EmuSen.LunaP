<Project Sdk="Microsoft.NET.Sdk">

  <!-- LunaP's own suite. Everything here is headless: no window is ever put on
       a screen, including for the render tests, which drive a real Avalonia
       control tree through a real Skia pass under Avalonia.Headless.

       These tests lived in EmuSen.WiseMan until the toolkit left that
       repository. What did NOT come with them is the one test that checked
       LunaP's palette keys against EmuSen's own `man theme` page: that asserts
       EmuSen's documentation stays in step with this project, which is
       EmuSen's business and not this project's. See docs/LunaP.md §20. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- OFF, SO THAT EVERY FILE SPELLS ITS OWN IMPORTS - see docs/LunaP.md §74.7.
         The SDK would supply System, System.Collections.Generic, System.Linq and a
         few more to every file for free. Every file here already writes them, so
         nothing is gained by the convenience and one real thing is lost: with it
         ON, a missing `using` is invisible, and there is no way to tell a file
         that imports what it needs from one that is quietly living off the
         default set. Two files were, and nobody could have known.
         Off, the compiler enforces the convention instead of the author
         remembering it. It does NOT catch an UNNECESSARY using - nothing here
         does, and §74.6 says why that is recorded rather than guarded. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Real Avalonia render passes with no display and no GPU. Not
         Avalonia.Headless.XUnit: that package pins xunit.v3, which collides
         with xunit 2.9.3 on the Fact/Theory/InlineData types.
         HeadlessUnitTestSession, in plain Avalonia.Headless, gives the same
         capability against ordinary [Fact] and async Task. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <!-- The render pass the captures go through - see Fixtures in UiTest.cs. -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="EmuSen.LunaP.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EmuSen.LunaP\EmuSen.LunaP.csproj" />
    <!-- The harness is a package now, and this suite consumes it exactly as any
         other consumer would - which is what stops it drifting back into being
         private. docs/LunaP.md §22.8. -->
    <ProjectReference Include="..\..\src\EmuSen.LunaP.Testing\EmuSen.LunaP.Testing.csproj" />
  </ItemGroup>

</Project>
